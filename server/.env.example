# Copie para server/.env e preencha. Nunca commite o .env com valores reais.

# Porta HTTP do servidor (padrao: 3001)
PORT=3001

# Caminho do arquivo SQLite (padrao: server/data/app.db)
DB_PATH=

# Senha do painel admin. Obrigatoria fora de dev/test (so NODE_ENV=development|test usa default inseguro).
ADMIN_PASSWORD=

# Segredo para assinar os JWT (minimo 16 caracteres). Obrigatorio fora de dev/test.
JWT_SECRET=

# URL publica do front (usada nos links enviados por e-mail)
PUBLIC_URL=http://localhost:3000

# Endpoint da API de e-mail
EMAIL_API_URL=https://api-erp.rainhadassete.com.br/Email/enviar

# Origem permitida no CORS (front)
CORS_ORIGIN=http://localhost:3000

# Ambiente: development | production | test. Normalmente definido pelos scripts
# (`npm run dev` = development, `npm start` = production). Se ausente, exige ADMIN_PASSWORD e JWT_SECRET.
# NODE_ENV=production

# Pausa (ms) entre e-mails do lote (padrao: 0)
EMAIL_SEND_DELAY_MS=0

# Defina como true/1 quando atras de um proxy reverso (usa X-Forwarded-For no rate limit do login)
TRUST_PROXY=false
