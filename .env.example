# URL base da API usada pelo front.
# Em desenvolvimento, deixe /api: o proxy do Vite (vite.config.ts) encaminha
# para o backend em http://localhost:3001.
# Em producao, aponte para a URL publica da API, ex.: https://api.seudominio.com/api
VITE_API_URL=/api

# ---------------------------------------------------------------------------
# Docker Compose (`docker compose up -d --build`)
# O compose le este arquivo como .env na raiz. Apenas VITE_* chega ao front.
# ---------------------------------------------------------------------------

# Obrigatorias: senha do painel admin e segredo do JWT (minimo 16 caracteres)
ADMIN_PASSWORD=
JWT_SECRET=

# URL publica do site (usada nos links enviados por e-mail e no CORS)
PUBLIC_URL=http://localhost:3000

# Porta publicada no host para o site (padrao 3000)
WEB_PORT=3000

# Opcionais
# EMAIL_API_URL=https://api-erp.rainhadassete.com.br/Email/enviar
# EMAIL_SEND_DELAY_MS=0
